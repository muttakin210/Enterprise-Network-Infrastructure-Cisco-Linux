{
  "uid": "enl-lab-overview",
  "title": "ENL Lab overview",
  "description": "Two-site lab: Zabbix (SNMPv3 + agent) and LibreNMS (SNMPv3) in one view",
  "tags": [
    "enl",
    "zabbix",
    "librenms"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Devices up (LibreNMS)",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "mysql",
        "uid": "librenms"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT COUNT(*) AS up FROM devices WHERE status = 1 AND disabled = 0"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Devices down (LibreNMS)",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "datasource": {
        "type": "mysql",
        "uid": "librenms"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT COUNT(*) AS down FROM devices WHERE status = 0 AND disabled = 0"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "id": 3,
      "type": "alexanderzobnin-zabbix-triggers-panel",
      "title": "Zabbix problems (active and recent)",
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 8,
        "y": 0
      },
      "datasource": {
        "type": "alexanderzobnin-zabbix-datasource",
        "uid": "zabbix"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "5",
          "group": {
            "filter": "/^Lab/"
          },
          "host": {
            "filter": "/.*/"
          },
          "application": {
            "filter": ""
          },
          "proxy": {
            "filter": ""
          },
          "trigger": {
            "filter": ""
          },
          "tags": {
            "filter": ""
          },
          "options": {
            "hostsInMaintenance": false,
            "sortProblems": "default",
            "minSeverity": 0,
            "acknowledged": 2,
            "limit": 50
          },
          "schema": 13,
          "showProblems": "recent"
        }
      ],
      "options": {
        "showTags": true,
        "showDatetime": true,
        "hostField": true,
        "severityField": true,
        "statusField": true,
        "ageField": true,
        "layout": "table",
        "pageSize": 10
      }
    },
    {
      "id": 4,
      "type": "table",
      "title": "Inventory and status (LibreNMS)",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "mysql",
        "uid": "librenms"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT sysName AS device, hostname AS ip, IF(status=1,'up','DOWN') AS status, ROUND(uptime/3600,1) AS uptime_h, last_polled FROM devices ORDER BY sysName"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "up": {
                        "color": "green",
                        "index": 0
                      },
                      "DOWN": {
                        "color": "red",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "ICMP response time (Zabbix)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 11
      },
      "datasource": {
        "type": "alexanderzobnin-zabbix-datasource",
        "uid": "zabbix"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "0",
          "group": {
            "filter": "/^Lab/"
          },
          "host": {
            "filter": "/.*/"
          },
          "application": {
            "filter": ""
          },
          "itemTag": {
            "filter": ""
          },
          "item": {
            "filter": "ICMP response time"
          },
          "functions": [],
          "options": {
            "showDisabledItems": false
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "WAN link traffic HQ-R1 g0-1 (Zabbix, SNMPv3)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "alexanderzobnin-zabbix-datasource",
        "uid": "zabbix"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "0",
          "group": {
            "filter": "Lab/Routers"
          },
          "host": {
            "filter": "hq-r1"
          },
          "application": {
            "filter": ""
          },
          "itemTag": {
            "filter": ""
          },
          "item": {
            "filter": "/Interface g0-1\\(.*\\): Bits (received|sent)/"
          },
          "functions": [],
          "options": {
            "showDisabledItems": false
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "state-timeline",
      "title": "WAN operational status (Zabbix: green = up, red = down)",
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "datasource": {
        "type": "alexanderzobnin-zabbix-datasource",
        "uid": "zabbix"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "0",
          "group": {
            "filter": "Lab/Routers"
          },
          "host": {
            "filter": "/hq-r1|br-r2/"
          },
          "application": {
            "filter": ""
          },
          "itemTag": {
            "filter": ""
          },
          "item": {
            "filter": "/Interface g0-1\\(.*\\): Operational status/"
          },
          "functions": [],
          "options": {
            "showDisabledItems": false
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "range",
              "options": {
                "from": 1,
                "to": 1,
                "result": {
                  "text": "up",
                  "color": "green",
                  "index": 0
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 2,
                "to": 7,
                "result": {
                  "text": "down",
                  "color": "red",
                  "index": 1
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "rowHeight": 0.8,
        "legend": {
          "showLegend": false
        }
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "Interface events (LibreNMS event log)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 19
      },
      "datasource": {
        "type": "mysql",
        "uid": "librenms"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT DATE_FORMAT(e.datetime, '%Y-%m-%d %H:%i:%s') AS time_local, d.sysName AS device, e.type AS port, e.message FROM eventlog e JOIN devices d USING(device_id) WHERE e.message LIKE 'ifOperStatus:%' ORDER BY e.event_id DESC LIMIT 20"
        }
      ]
    }
  ]
}
